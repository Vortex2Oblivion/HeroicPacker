<?xml version="1.0" encoding="UTF-8"?>
<!--
Created with {{appInfo.displayName}} v{{appInfo.version}} {{{appInfo.url}}}
-->
<TextureAtlas imagePath="{{{config.imageFile}}}">
	{{#rects}}
	<SubTexture name="{{{name}}}" x="{{frame.x}}" y="{{frame.y}}" w="{{frame.w}}" h="{{frame.h}}"/>
	{{/rects}}
</TextureAtlas>